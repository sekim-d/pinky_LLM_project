<?xml version='1.0'?>
<launch>
  <arg name="world_name" default="pinky_factory.world"/>
  <arg name="map_file"   default="/home/ane/pinky_sekim/my_map.yaml"/>
  <arg name="params_file" default="$(find-pkg-share pinky_navigation)/params/nav2_params.yaml"/>

  <!-- 1. Gazebo 시뮬레이션 -->
  <include file="$(find-pkg-share pinky_gazebo)/launch/launch_sim.launch.xml">
    <arg name="world_name" value="$(var world_name)"/>
  </include>

  <!-- 2. 저장된 맵 로드 -->
  <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="yaml_filename" value="$(var map_file)"/>
  </node>

  <!-- 3. AMCL 위치 추정 -->
  <node pkg="nav2_amcl" exec="amcl" name="amcl" output="screen">
    <param name="use_sim_time" value="true"/>
    <param from="$(find-pkg-share pinky_navigation)/params/amcl_params.yaml"/>
  </node>

  <!-- 4. map_server + amcl lifecycle 관리 -->
  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_localization" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="autostart"    value="true"/>
    <param name="node_names"   value="['map_server', 'amcl']"/>
  </node>

  <!-- 5. Nav2 내비게이션 -->
  <include file="$(find-pkg-share pinky_navigation)/launch/navigation_launch.xml">
    <arg name="use_sim_time"  value="true"/>
    <arg name="params_file"   value="$(var params_file)"/>
  </include>

</launch>
