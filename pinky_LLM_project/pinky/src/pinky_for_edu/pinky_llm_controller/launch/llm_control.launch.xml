<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="model"        default="qwen2.5:7b"/>

  <!-- Qwen LLM 기반 자연어 로봇 제어 노드 -->
  <node pkg="pinky_llm_controller" exec="llm_controller" name="llm_controller" output="screen">
    <param name="ollama_url"    value="http://localhost:11434"/>
    <param name="model"         value="$(var model)"/>  <!-- 파인튜닝 모델: pinky-qwen -->
    <param name="use_sim_time"  value="$(var use_sim_time)"/>
  </node>
</launch>
